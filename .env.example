# Configuração do Cobra. Copie para `.env` na raiz do repositório e preencha.
# O site (web/) e os coletores (collectors/) leem este mesmo arquivo.
# Nunca coloque valores reais neste exemplo: ele é público.

# Ambiente de execução: development, test ou production. Obrigatória.
APP_ENV=development

# Nível de log: debug, info, warn ou error. Opcional (padrão: info).
LOG_LEVEL=info

# Commit em produção, exibido em /api/health. Opcional; preenchido pelo deploy.
APP_COMMIT_SHA=

# Endereço público do site (ex.: https://exemplo.org.br), usado na prévia de links e no
# rodapé dos cards de compartilhar. Opcional; padrão: http://localhost:3000. Em produção,
# defina: sem ele, a prévia no WhatsApp e nas redes aponta para localhost.
SITE_URL=

# Conexão do site com o banco, somente leitura. Opcional: sem ela o site fica no ar,
# mas as páginas de dados mostram "dados indisponíveis". Em produção, use um usuário
# do papel cobra_web_reader (docs/modelo-de-dados.md). Localmente, o Supabase local.
WEB_DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres

# Painel editorial (change painel-editorial). Opcionais: sem elas, o painel fica fora do ar.
# Endereço e chave publicável do Supabase (públicos por natureza; só servem para o login dos
# editores). Localmente: `npx supabase status` mostra API_URL e PUBLISHABLE_KEY.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Conexão do painel com o banco, papel cobra_editor (lê core e grava só o trabalho editorial).
# Localmente pode ser a mesma do Supabase local.
EDITOR_DATABASE_URL=
# Chave secreta do Supabase, usada só pelo script web/scripts/add-editor.mjs para criar
# editores. Nunca no navegador nem no deploy do site.
SUPABASE_SECRET_KEY=

# Conexão com o Postgres usada pelos coletores. Obrigatória nos coletores.
# Valor do Supabase local (`pnpm db:start`); em produção, use a URL do projeto.
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres

# Pasta onde os coletores guardam arquivos brutos grandes (ZIP, PDF). Opcional;
# padrão: data/raw na raiz do repositório (ignorada pelo git).
RAW_DATA_DIR=

# Postgres de administração usado só pelos testes de banco (`pnpm check:db`), que
# criam e apagam um banco descartável. Opcional; padrão: Supabase local.
TEST_DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres
